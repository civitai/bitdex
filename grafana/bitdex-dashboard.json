{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Query Performance",
      "type": "row"
    },
    {
      "title": "QPS",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(bitdex_query_total{index=~\"$index\"}[$__rate_interval])",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Query Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(bitdex_query_duration_seconds_bucket{index=~\"$index\"}[$__rate_interval]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(bitdex_query_duration_seconds_bucket{index=~\"$index\"}[$__rate_interval]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(bitdex_query_duration_seconds_bucket{index=~\"$index\"}[$__rate_interval]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Query Latency Heatmap",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" },
        "color": { "scheme": "Oranges" }
      },
      "targets": [
        {
          "expr": "rate(bitdex_query_duration_seconds_bucket{index=~\"$index\"}[$__rate_interval])",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Cache",
      "type": "row"
    },
    {
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "bitdex_cache_hits_total{index=~\"$index\"} / clamp_min(bitdex_cache_hits_total{index=~\"$index\"} + bitdex_cache_misses_total{index=~\"$index\"}, 1)",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cache Entries",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 10 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "bitdex_cache_entries{index=~\"$index\"}",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cache Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 10 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "decbytes" }
      },
      "targets": [
        {
          "expr": "bitdex_cache_bytes{index=~\"$index\"}",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cache Hits vs Misses",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "hits" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "misses" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "bitdex_cache_hits_total{index=~\"$index\"}",
          "legendFormat": "hits",
          "refId": "A"
        },
        {
          "expr": "bitdex_cache_misses_total{index=~\"$index\"}",
          "legendFormat": "misses",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Hits (cumulative)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 14 },
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "bitdex_cache_hits_total{index=~\"$index\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Misses (cumulative)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 14 },
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "bitdex_cache_misses_total{index=~\"$index\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Documents & Writes",
      "type": "row"
    },
    {
      "title": "Alive Documents",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 19 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "bitdex_alive_documents{index=~\"$index\"}",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Slot High Water",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 19 },
      "id": 11,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "bitdex_slot_high_water{index=~\"$index\"}",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Upsert Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(bitdex_upsert_total{index=~\"$index\"}[$__rate_interval])",
          "legendFormat": "upserts/s",
          "refId": "A"
        },
        {
          "expr": "rate(bitdex_delete_total{index=~\"$index\"}[$__rate_interval])",
          "legendFormat": "deletes/s",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Snapshot Publishes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 19 },
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "bitdex_snapshot_publish_total{index=~\"$index\"}",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Last Flush Duration",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 19 },
      "id": 14,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "ns" }
      },
      "targets": [
        {
          "expr": "bitdex_flush_last_duration_nanos{index=~\"$index\"}",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Pending Fields (lazy load)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 23 },
      "id": 15,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "bitdex_pending_fields{index=~\"$index\"}",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Flush Duration Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "id": 16,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "bitdex_flush_last_duration_nanos{index=~\"$index\"}",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 103,
      "title": "Bitmap Memory",
      "type": "row"
    },
    {
      "title": "Filter Bitmap Memory by Field",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 20,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "bitdex_filter_bitmap_bytes{index=~\"$index\"}",
          "legendFormat": "{{field}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Sort Bitmap Memory by Field",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 32 },
      "id": 21,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "bitdex_sort_bitmap_bytes{index=~\"$index\"}",
          "legendFormat": "{{field}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Slot Bitmap Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 32 },
      "id": 22,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "decbytes" }
      },
      "targets": [
        {
          "expr": "bitdex_slot_bitmap_bytes{index=~\"$index\"}",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Bitmap Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 36 },
      "id": 23,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "decbytes" }
      },
      "targets": [
        {
          "expr": "sum(bitdex_filter_bitmap_bytes{index=~\"$index\"}) + sum(bitdex_sort_bitmap_bytes{index=~\"$index\"}) + bitdex_slot_bitmap_bytes{index=~\"$index\"}",
          "legendFormat": "total",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Filter Bitmap Counts by Field",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 24,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "displayName", "value": "Bitmap Count" }]
          },
          {
            "matcher": { "id": "byName", "options": "field" },
            "properties": [{ "id": "displayName", "value": "Field" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Bitmap Count", "desc": true }]
      },
      "transformations": [
        {
          "id": "reduce",
          "options": { "reducers": ["lastNotNull"] }
        }
      ],
      "targets": [
        {
          "expr": "bitdex_filter_bitmap_count{index=~\"$index\"}",
          "legendFormat": "{{field}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Memory Breakdown (pie)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "id": 25,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      },
      "targets": [
        {
          "expr": "bitdex_filter_bitmap_bytes{index=~\"$index\"}",
          "legendFormat": "filter: {{field}}",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "bitdex_sort_bitmap_bytes{index=~\"$index\"}",
          "legendFormat": "sort: {{field}}",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "bitdex_slot_bitmap_bytes{index=~\"$index\"}",
          "legendFormat": "slots",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "bitdex_cache_bytes{index=~\"$index\"}",
          "legendFormat": "cache",
          "instant": true,
          "refId": "D"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["bitdex"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(bitdex_alive_documents, index)",
        "hide": 0,
        "includeAll": true,
        "label": "Index",
        "multi": true,
        "name": "index",
        "query": "label_values(bitdex_alive_documents, index)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "BitDex",
  "uid": "bitdex-overview",
  "version": 1
}
